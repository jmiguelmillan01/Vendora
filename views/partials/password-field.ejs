<%
  // Locals esperados: id, name, label (puede traer HTML, ej. un asterisco),
  // placeholder, required, minlength, autocomplete, autofocus.
  var placeholderFinal = typeof placeholder !== 'undefined' ? placeholder : '••••••••';
  var requeridoFinal = typeof required === 'undefined' ? true : required;
  var autofocusFinal = typeof autofocus !== 'undefined' && autofocus;
%>
<div class="relative rounded-lg border border-slate-300 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500" data-password-field>
  <label for="<%= id %>" class="block text-xs font-medium text-slate-500 px-4 pt-2">
    <%- label %>
  </label>
  <input
    type="password"
    id="<%= id %>"
    name="<%= name %>"
    <% if (requeridoFinal) { %>required<% } %>
    <% if (typeof minlength !== 'undefined') { %>minlength="<%= minlength %>"<% } %>
    <% if (typeof autocomplete !== 'undefined') { %>autocomplete="<%= autocomplete %>"<% } %>
    <% if (autofocusFinal) { %>autofocus<% } %>
    class="block w-full rounded-lg border-0 bg-transparent px-4 pb-2.5 pt-0.5 pr-11 text-base text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-0"
    placeholder="<%= placeholderFinal %>"
  />
</div>
