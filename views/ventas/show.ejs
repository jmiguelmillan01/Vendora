<%- include('../partials/header', { titulo: `Venta #${venta.id}`, activeNav: 'ventas' }) %>

<%
  const etiquetasTipoPago = { CONTADO: 'Contado', CREDITO: 'Crédito', PARCIAL: 'Parcial' };
%>

<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center gap-2 text-sm text-slate-500">
    <a href="/ventas" class="hover:text-indigo-700">Ventas</a>
    <span>/</span>
    <span class="text-slate-700">Venta #<%= venta.id %></span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Venta #<%= venta.id %></h1>
      <p class="text-sm text-slate-500">
        <a href="/clientes/<%= venta.cliente_id %>" class="text-indigo-700 hover:underline"><%= venta.cliente_nombre %></a>
        · <%= formatFecha(venta.fecha) %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%- include('../partials/badge-estado-venta', { estado: venta.estado }) %>
    </div>
  </div>

  <!-- Productos/servicios -->
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-left text-slate-500">
          <th class="px-4 py-3 font-medium">Producto/Servicio</th>
          <th class="px-4 py-3 font-medium text-right">Cantidad</th>
          <th class="px-4 py-3 font-medium text-right">Precio unitario</th>
          <th class="px-4 py-3 font-medium text-right">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% detalles.forEach(function (detalle) { %>
          <tr class="border-b border-slate-100 last:border-0">
            <td class="px-4 py-3 text-slate-900">
              <%= detalle.producto_nombre %>
              <span class="text-xs text-slate-400">(<%= detalle.producto_tipo === 'servicio' ? 'Servicio' : 'Producto' %>)</span>
            </td>
            <td class="px-4 py-3 text-right text-slate-600"><%= Number(detalle.cantidad) %></td>
            <td class="px-4 py-3 text-right text-slate-600"><%= formatMoney(detalle.precio_unitario) %></td>
            <td class="px-4 py-3 text-right font-medium text-slate-900"><%= formatMoney(detalle.subtotal) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Resumen -->
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 sm:p-6 space-y-1.5 text-sm">
    <div class="flex justify-between text-slate-600">
      <span>Subtotal</span>
      <span><%= formatMoney(venta.subtotal) %></span>
    </div>
    <% if (Number(venta.descuento) > 0) { %>
      <div class="flex justify-between text-slate-600">
        <span>Descuento</span>
        <span>- <%= formatMoney(venta.descuento) %></span>
      </div>
    <% } %>
    <div class="flex justify-between text-base font-semibold text-slate-900 pt-1.5 border-t border-slate-100">
      <span>Total</span>
      <span><%= formatMoney(venta.total) %></span>
    </div>
    <div class="flex justify-between text-slate-500 pt-1.5">
      <span>Forma de pago</span>
      <span><%= etiquetasTipoPago[venta.tipo_pago] || venta.tipo_pago %></span>
    </div>
  </div>

  <% if (venta.observaciones) { %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 sm:p-6">
      <p class="text-xs font-medium text-slate-500 mb-1">Observaciones</p>
      <p class="text-sm text-slate-700"><%= venta.observaciones %></p>
    </div>
  <% } %>

  <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
    <a
      href="/clientes/<%= venta.cliente_id %>"
      class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-3 sm:py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
    >
      Ver estado de cuenta del cliente
    </a>
    <% if (venta.estado !== 'ANULADA') { %>
      <form
        method="POST"
        action="/ventas/<%= venta.id %>/anular"
        onsubmit="return confirm('¿Anular esta venta? Esta acción no se puede deshacer. El historial queda registrado, pero la venta dejará de contar para el saldo del cliente.');"
      >
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center rounded-lg border border-red-300 px-4 py-3 sm:py-2.5 text-sm font-medium text-red-600 hover:bg-red-50 transition-colors"
        >
          Anular venta
        </button>
      </form>
    <% } %>
  </div>

  <% if (venta.estado === 'ANULADA') { %>
    <div class="rounded-lg bg-slate-100 border border-slate-200 text-slate-500 text-sm px-4 py-3">
      Esta venta está anulada y no cuenta para el saldo del cliente. Si fue un error, registra una nueva venta con los datos correctos.
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
