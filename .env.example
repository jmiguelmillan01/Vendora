DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_ventas
SESSION_SECRET=cambia_este_valor_por_uno_seguro
PORT=3000

# API REST para la app móvil (/api/v1) — autenticación por JWT, independiente
# de SESSION_SECRET (que sigue usando solo la web).
JWT_SECRET=cambia_este_valor_por_uno_seguro_y_distinto_de_session_secret
JWT_EXPIRES_IN=7d

# Recuperación de contraseña por correo (Gmail)
# GMAIL_USER: tu dirección de Gmail
# GMAIL_APP_PASSWORD: contraseña de aplicación de 16 dígitos (no tu contraseña normal)
# generada en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
