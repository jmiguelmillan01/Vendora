<%- include('../partials/header', { titulo: 'Ventas', activeNav: 'ventas' }) %>

<%
  const etiquetasTipoPago = { CONTADO: 'Contado', CREDITO: 'Crédito', PARCIAL: 'Parcial' };
%>

<div class="max-w-5xl mx-auto space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Ventas</h1>
    <a
      href="/ventas/nueva"
      class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-3 sm:py-2.5 text-white text-sm font-medium shadow hover:bg-indigo-700 active:bg-indigo-800 transition-colors"
    >
      + Nueva venta
    </a>
  </div>

  <form method="GET" action="/ventas" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 flex flex-wrap gap-3">
    <select
      name="cliente_id"
      class="flex-1 min-w-[10rem] rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    >
      <option value="">Todos los clientes</option>
      <% clientes.forEach(function (cliente) { %>
        <option value="<%= cliente.id %>" <%= String(filtros.clienteId) === String(cliente.id) ? 'selected' : '' %>>
          <%= cliente.nombre %>
        </option>
      <% }); %>
    </select>
    <select
      name="estado"
      class="rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    >
      <option value="" <%= filtros.estado === '' ? 'selected' : '' %>>Todos los estados</option>
      <option value="PAGADA" <%= filtros.estado === 'PAGADA' ? 'selected' : '' %>>Pagada</option>
      <option value="PENDIENTE" <%= filtros.estado === 'PENDIENTE' ? 'selected' : '' %>>Pendiente</option>
      <option value="PARCIAL" <%= filtros.estado === 'PARCIAL' ? 'selected' : '' %>>Parcial</option>
      <option value="ANULADA" <%= filtros.estado === 'ANULADA' ? 'selected' : '' %>>Anulada</option>
    </select>
    <input
      type="date"
      name="fechaInicio"
      value="<%= filtros.fechaInicio %>"
      class="rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <input
      type="date"
      name="fechaFin"
      value="<%= filtros.fechaFin %>"
      class="rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-lg bg-slate-800 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-900 transition-colors"
    >
      Filtrar
    </button>
  </form>

  <% if (ventas.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8 text-center text-sm text-slate-500">
      No se encontraron ventas con los filtros seleccionados.
    </div>
  <% } else { %>
    <!-- Tabla (escritorio / tablet) -->
    <div class="hidden md:block bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-slate-500">
            <th class="px-4 py-3 font-medium">#</th>
            <th class="px-4 py-3 font-medium">Fecha</th>
            <th class="px-4 py-3 font-medium">Cliente</th>
            <th class="px-4 py-3 font-medium hidden lg:table-cell">Forma de pago</th>
            <th class="px-4 py-3 font-medium text-right">Total</th>
            <th class="px-4 py-3 font-medium">Estado</th>
            <th class="px-4 py-3 font-medium text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% ventas.forEach(function (venta) { %>
            <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50">
              <td class="px-4 py-3 text-slate-500">#<%= venta.id %></td>
              <td class="px-4 py-3 text-slate-600"><%= formatFecha(venta.fecha) %></td>
              <td class="px-4 py-3 font-medium text-slate-900"><%= venta.cliente_nombre %></td>
              <td class="px-4 py-3 text-slate-600 hidden lg:table-cell"><%= etiquetasTipoPago[venta.tipo_pago] || venta.tipo_pago %></td>
              <td class="px-4 py-3 text-right font-medium text-slate-900"><%= formatMoney(venta.total) %></td>
              <td class="px-4 py-3"><%- include('../partials/badge-estado-venta', { estado: venta.estado }) %></td>
              <td class="px-4 py-3 text-right">
                <a href="/ventas/<%= venta.id %>" class="text-indigo-600 hover:text-indigo-700 text-xs font-medium">Ver</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Cards (móvil) -->
    <div class="md:hidden space-y-3">
      <% ventas.forEach(function (venta) { %>
        <a href="/ventas/<%= venta.id %>" class="block bg-white border border-slate-200 rounded-xl shadow-sm p-4 space-y-2">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold text-slate-900">Venta #<%= venta.id %></p>
              <p class="text-sm text-slate-500"><%= venta.cliente_nombre %></p>
            </div>
            <span class="shrink-0 font-medium text-slate-900"><%= formatMoney(venta.total) %></span>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <span class="text-xs text-slate-500"><%= formatFecha(venta.fecha) %> · <%= etiquetasTipoPago[venta.tipo_pago] || venta.tipo_pago %></span>
            <%- include('../partials/badge-estado-venta', { estado: venta.estado }) %>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>

  <%- include('../partials/pagination') %>
</div>

<%- include('../partials/footer') %>
