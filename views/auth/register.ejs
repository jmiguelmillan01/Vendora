<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 flex items-center justify-center px-4 py-8">
  <main class="w-full max-w-sm sm:max-w-md">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-indigo-600 text-white text-xl font-bold">
        SV
      </div>
      <h1 class="mt-4 text-2xl font-bold text-slate-900">Crea tu cuenta</h1>
      <p class="mt-1 text-sm text-slate-500">Gestiona los clientes, productos y fiados de tu negocio</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 sm:p-6">
      <% if (errores.length) { %>
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
          <ul class="list-disc list-inside space-y-1">
            <% errores.forEach(function (mensaje) { %>
              <li><%= mensaje %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form method="POST" action="/registro" class="space-y-4" novalidate>
        <div>
          <label for="nombre" class="block text-sm font-medium text-slate-700 mb-1">
            Nombre completo
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            value="<%= valores.nombre %>"
            required
            maxlength="150"
            autocomplete="name"
            autofocus
            class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="Tu nombre"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">
            Correo electrónico
          </label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= valores.email %>"
            required
            maxlength="150"
            autocomplete="email"
            class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="tucorreo@negocio.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-slate-700 mb-1">
            Contraseña
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            autocomplete="new-password"
            class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="Mínimo 6 caracteres"
          />
        </div>

        <div>
          <label for="password_confirmacion" class="block text-sm font-medium text-slate-700 mb-1">
            Confirmar contraseña
          </label>
          <input
            type="password"
            id="password_confirmacion"
            name="password_confirmacion"
            required
            minlength="6"
            autocomplete="new-password"
            class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-3 text-white font-medium shadow hover:bg-indigo-700 active:bg-indigo-800 transition-colors"
        >
          Crear cuenta
        </button>
      </form>

      <p class="mt-4 text-center text-sm text-slate-500">
        ¿Ya tienes cuenta?
        <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-700">Inicia sesión</a>
      </p>
    </div>
  </main>
</body>
</html>
