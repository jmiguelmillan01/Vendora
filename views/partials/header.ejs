<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %> · Sistema de Ventas</title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-800">
  <div class="lg:flex">
    <!-- Sidebar escritorio -->
    <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 lg:h-screen lg:sticky lg:top-0 border-r border-slate-200 bg-white">
      <div class="flex items-center gap-2 px-5 py-4 border-b border-slate-200">
        <div class="h-9 w-9 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">SV</div>
        <span class="font-semibold text-slate-900">Sistema de Ventas</span>
      </div>
      <%- include('./sidebar-nav', { activeNav: typeof activeNav !== 'undefined' ? activeNav : '' }) %>
    </aside>

    <!-- Barra superior móvil -->
    <div class="lg:hidden sticky top-0 z-30 flex items-center justify-between bg-white border-b border-slate-200 px-4 py-3">
      <div class="flex items-center gap-2">
        <div class="h-9 w-9 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">SV</div>
        <span class="font-semibold text-slate-900">Sistema de Ventas</span>
      </div>
      <button id="btn-abrir-menu" type="button" class="p-2 rounded-lg border border-slate-200 text-slate-600" aria-label="Abrir menú">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Overlay y drawer móvil -->
    <div id="drawer-overlay" class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden"></div>
    <div id="drawer-menu" class="fixed inset-y-0 left-0 z-50 w-72 max-w-[80%] h-full bg-white shadow-xl -translate-x-full transition-transform duration-200 lg:hidden flex flex-col">
      <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200">
        <span class="font-semibold text-slate-900">Menú</span>
        <button id="btn-cerrar-menu" type="button" class="p-2 rounded-lg text-slate-500" aria-label="Cerrar menú">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <%- include('./sidebar-nav', { activeNav: typeof activeNav !== 'undefined' ? activeNav : '' }) %>
    </div>

    <!-- Contenido principal -->
    <main class="flex-1 min-w-0 px-4 py-6 sm:px-6 lg:px-8 max-w-full">
      <%- include('./alert') %>
