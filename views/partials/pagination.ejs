<% if (paginacion.totalPaginas > 1) { %>
  <nav class="mt-4 flex items-center justify-between gap-3 text-sm" aria-label="Paginación">
    <a
      href="?page=<%= paginacion.paginaActual - 1 %>&<%= typeof queryString !== 'undefined' ? queryString : '' %>"
      class="px-3 py-2 rounded-lg border border-slate-200 <%= paginacion.paginaActual <= 1 ? 'pointer-events-none opacity-40' : 'hover:bg-slate-100 text-slate-700' %>"
    >
      Anterior
    </a>
    <span class="text-slate-500">
      Página <%= paginacion.paginaActual %> de <%= paginacion.totalPaginas %>
      <span class="hidden sm:inline">· <%= paginacion.total %> <%= paginacion.entidad || 'resultados' %></span>
    </span>
    <a
      href="?page=<%= paginacion.paginaActual + 1 %>&<%= typeof queryString !== 'undefined' ? queryString : '' %>"
      class="px-3 py-2 rounded-lg border border-slate-200 <%= paginacion.paginaActual >= paginacion.totalPaginas ? 'pointer-events-none opacity-40' : 'hover:bg-slate-100 text-slate-700' %>"
    >
      Siguiente
    </a>
  </nav>
<% } %>
