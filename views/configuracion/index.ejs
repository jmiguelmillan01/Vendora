<%- include('../partials/header', { titulo: 'Configuración', activeNav: 'configuracion' }) %>

<div class="max-w-lg mx-auto space-y-5">
  <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Configuración</h1>

  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 sm:p-6">
    <p class="text-xs font-medium text-slate-500 mb-1">Sesión iniciada como</p>
    <p class="text-sm font-medium text-slate-900"><%= usuario.nombre %></p>
    <p class="text-sm text-slate-500"><%= usuario.email %></p>
  </div>

  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 sm:p-6 space-y-4">
    <h2 class="text-sm font-semibold text-slate-900">Cambiar contraseña</h2>

    <% if (errores.length) { %>
      <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
        <ul class="list-disc list-inside space-y-1">
          <% errores.forEach(function (mensaje) { %>
            <li><%= mensaje %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/configuracion/password" class="space-y-4">
      <%- include('../partials/password-field', {
        id: 'password_actual',
        name: 'password_actual',
        label: 'Contraseña actual <span class="text-red-500">*</span>',
        autocomplete: 'current-password'
      }) %>

      <div>
        <%- include('../partials/password-field', {
          id: 'password_nueva',
          name: 'password_nueva',
          label: 'Nueva contraseña <span class="text-red-500">*</span>',
          minlength: 6,
          autocomplete: 'new-password'
        }) %>
        <p class="mt-1 text-xs text-slate-400">Mínimo 6 caracteres.</p>
      </div>

      <%- include('../partials/password-field', {
        id: 'password_confirmacion',
        name: 'password_confirmacion',
        label: 'Confirmar nueva contraseña <span class="text-red-500">*</span>',
        minlength: 6,
        autocomplete: 'new-password'
      }) %>

      <button
        type="submit"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-white font-medium shadow hover:bg-indigo-700 active:bg-indigo-800 transition-colors"
      >
        Guardar cambios
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
