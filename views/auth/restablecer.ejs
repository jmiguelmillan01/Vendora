<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 flex items-center justify-center px-4 py-8">
  <main class="w-full max-w-sm sm:max-w-md">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-indigo-600 text-white text-xl font-bold">
        SV
      </div>
      <h1 class="mt-4 text-2xl font-bold text-slate-900">Restablecer contraseña</h1>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 sm:p-6">
      <% if (!tokenValido) { %>
        <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
          Este enlace no es válido o ya venció. Solicita uno nuevo.
        </div>
        <p class="mt-4 text-center text-sm text-slate-500">
          <a href="/recuperar" class="font-medium text-indigo-600 hover:text-indigo-700">Solicitar nuevo enlace</a>
        </p>
      <% } else { %>
        <% if (errores.length) { %>
          <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
            <ul class="list-disc list-inside space-y-1">
              <% errores.forEach(function (mensaje) { %>
                <li><%= mensaje %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <form method="POST" action="/recuperar/restablecer" class="space-y-4" novalidate>
          <input type="hidden" name="token" value="<%= token %>" />

          <%- include('../partials/password-field', {
            id: 'password_nueva',
            name: 'password_nueva',
            label: 'Nueva contraseña',
            minlength: 6,
            autocomplete: 'new-password',
            autofocus: true,
            placeholder: 'Mínimo 6 caracteres'
          }) %>

          <%- include('../partials/password-field', {
            id: 'password_confirmacion',
            name: 'password_confirmacion',
            label: 'Confirmar nueva contraseña',
            minlength: 6,
            autocomplete: 'new-password'
          }) %>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-3 text-white font-medium shadow hover:bg-indigo-700 active:bg-indigo-800 transition-colors"
          >
            Guardar nueva contraseña
          </button>
        </form>
      <% } %>
    </div>
  </main>
  <script src="/js/password-toggle.js"></script>
</body>
</html>
