<%- include('../partials/header', { titulo: cliente.nombre, activeNav: 'clientes' }) %>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex items-center gap-2 text-sm text-slate-500">
    <a href="/clientes" class="hover:text-indigo-700">Clientes</a>
    <span>/</span>
    <span class="text-slate-700"><%= cliente.nombre %></span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900"><%= cliente.nombre %></h1>
      <p class="text-sm text-slate-500">
        <%= cliente.telefono || 'Sin teléfono' %><% if (cliente.email) { %> · <%= cliente.email %><% } %>
      </p>
    </div>
    <a
      href="/clientes/<%= cliente.id %>/editar"
      class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
    >
      Editar cliente
    </a>
  </div>

  <!-- Saldo destacado -->
  <div class="rounded-xl border p-5 sm:p-6 <%= resumen.saldo > 0 ? 'bg-red-50 border-red-200' : 'bg-green-50 border-green-200' %>">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <p class="text-sm <%= resumen.saldo > 0 ? 'text-red-700' : 'text-green-700' %>">Saldo pendiente</p>
        <p class="text-3xl sm:text-4xl font-bold <%= resumen.saldo > 0 ? 'text-red-700' : 'text-green-700' %>">
          <%= resumen.saldo > 0 ? formatMoney(resumen.saldo) : 'SIN DEUDA' %>
        </p>
      </div>
      <% if (resumen.saldo > 0) { %>
        <a
          href="/abonos/nuevo?cliente_id=<%= cliente.id %>"
          class="inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-3 sm:py-2.5 text-white text-sm font-medium shadow hover:bg-red-700 active:bg-red-800 transition-colors"
        >
          Registrar abono
        </a>
      <% } %>
    </div>
  </div>

  <!-- Resumen -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4">
      <p class="text-xs text-slate-500">Total a crédito</p>
      <p class="mt-1 text-base sm:text-lg font-semibold text-slate-900"><%= formatMoney(resumen.totalCredito) %></p>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4">
      <p class="text-xs text-slate-500">Total abonado</p>
      <p class="mt-1 text-base sm:text-lg font-semibold text-slate-900"><%= formatMoney(resumen.totalAbonado) %></p>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4">
      <p class="text-xs text-slate-500">Última compra</p>
      <p class="mt-1 text-base sm:text-lg font-semibold text-slate-900"><%= formatFecha(resumen.fechaUltimaCompra) %></p>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4">
      <p class="text-xs text-slate-500">Último abono</p>
      <p class="mt-1 text-base sm:text-lg font-semibold text-slate-900"><%= formatFecha(resumen.fechaUltimoAbono) %></p>
    </div>
  </div>

  <!-- Historial -->
  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <h2 class="text-lg font-semibold text-slate-900">Historial de movimientos</h2>
      <form method="GET" action="/clientes/<%= cliente.id %>" class="flex flex-wrap gap-2">
        <input
          type="date"
          name="fechaInicio"
          value="<%= filtros.fechaInicio %>"
          class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
        />
        <input
          type="date"
          name="fechaFin"
          value="<%= filtros.fechaFin %>"
          class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
        />
        <button
          type="submit"
          class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-900 transition-colors"
        >
          Filtrar
        </button>
      </form>
    </div>

    <% if (historial.length === 0) { %>
      <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8 text-center text-sm text-slate-500">
        Este cliente todavía no tiene ventas ni abonos registrados.
      </div>
    <% } else { %>
      <!-- Tabla (escritorio / tablet) -->
      <div class="hidden md:block bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-slate-500">
              <th class="px-4 py-3 font-medium">Fecha</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 font-medium">Descripción</th>
              <th class="px-4 py-3 font-medium text-right">Valor</th>
            </tr>
          </thead>
          <tbody>
            <% historial.forEach(function (mov) { %>
              <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50">
                <td class="px-4 py-3 text-slate-600"><%= formatFecha(mov.fecha) %></td>
                <td class="px-4 py-3">
                  <% if (mov.tipo === 'VENTA') { %>
                    <span class="inline-flex items-center rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium px-2.5 py-1">Venta</span>
                  <% } else { %>
                    <span class="inline-flex items-center rounded-full bg-green-50 text-green-700 text-xs font-medium px-2.5 py-1">Abono</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-slate-600"><%= mov.descripcion %></td>
                <td class="px-4 py-3 text-right font-medium <%= mov.valor < 0 ? 'text-green-700' : 'text-slate-900' %>">
                  <%= mov.valor < 0 ? '-' + formatMoney(Math.abs(mov.valor)) : formatMoney(mov.valor) %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Cards (móvil) -->
      <div class="md:hidden space-y-3">
        <% historial.forEach(function (mov) { %>
          <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 space-y-1">
            <div class="flex items-center justify-between">
              <% if (mov.tipo === 'VENTA') { %>
                <span class="inline-flex items-center rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium px-2.5 py-1">Venta</span>
              <% } else { %>
                <span class="inline-flex items-center rounded-full bg-green-50 text-green-700 text-xs font-medium px-2.5 py-1">Abono</span>
              <% } %>
              <span class="text-xs text-slate-500"><%= formatFecha(mov.fecha) %></span>
            </div>
            <p class="text-sm text-slate-700"><%= mov.descripcion %></p>
            <p class="text-base font-semibold <%= mov.valor < 0 ? 'text-green-700' : 'text-slate-900' %>">
              <%= mov.valor < 0 ? '-' + formatMoney(Math.abs(mov.valor)) : formatMoney(mov.valor) %>
            </p>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
